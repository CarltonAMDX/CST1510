# WEEK 6 - LOGIN ATTEMPTS REPORT
# CYBER SECURITY

# 1. Load and inspect data
df = pd.read_csv("login_attempts.csv")

print("FIRST FIVE LOGIN SESSIONS")
print(df.head())

print("\nDATA TYPES")
print(df.dtypes)

print("\nTOTAL LOGIN SESSIONS:", len(df))

# 2. Find sessions with 3 or more failed attempts
high_failures = df[df["failed"] >= 3]

print("\nSESSIONS WITH 3 OR MORE FAILURES")
print(high_failures)

# 3. Total failed attempts per IP
ip_failures = df.groupby("ip")["failed"].sum()

print("\nTOTAL FAILURES PER IP")
print(ip_failures)

# 4. Sort IP addresses
sorted_ips = ip_failures.sort_values(
    ascending=False
)

print("\nIP ADDRESSES RANKED BY FAILURES")
print(sorted_ips)

print("\nIP WITH MOST FAILURES")
print(sorted_ips.head(1))

# 5. Identify suspicious sessions
df["suspicious"] = df["failed"].apply(
    lambda x: True if x >= 3 else False
)

print("\nSUSPICIOUS LOGIN SESSIONS")
print(df[["ip", "attempts", "failed", "suspicious"]])

# 6. Create chart
ip_failures.plot(kind="bar")

plt.title("Failed Login Attempts Per IP")
plt.xlabel("IP Address")
plt.ylabel("Total Failed Attempts")
plt.tight_layout()
plt.savefig("login_attempts_chart.png")
plt.close()

# 7. Save suspicious sessions
suspicious_sessions = df[
    df["suspicious"] == True
]

suspicious_sessions.to_csv(
    "flagged_ips.csv",
    index=False
)

print("\nSaved flagged_ips.csv")

