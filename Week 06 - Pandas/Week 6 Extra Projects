import pandas as pd
import matplotlib.pyplot as plt

# Server Fleet Report
# This script analyses server usage across different regions.

# 1. Load and look at the data
df = pd.read_csv("servers.csv")

print("FIRST FIVE SERVERS:")
print(df.head())

print("\nDATA TYPES:")
print(df.dtypes)

print("\nNUMBER OF SERVERS:")
print(len(df))

print("\nNUMBER OF COLUMNS:")
print(len(df.columns))


# 2. Add a percent column
df["percent"] = (df["used"] / df["total"]) * 100

print("\nSERVER USAGE:")
print(df[["server", "region", "percent"]])


# 3. Filter servers at or above 90%
over_limit = df[df["percent"] >= 90]

print("\nSERVERS AT OR ABOVE 90%:")
print(over_limit)

print("\nNUMBER AT OR ABOVE 90%:")
print(len(over_limit))


# 4. Average percentage per region
region_average = df.groupby("region")["percent"].mean()

print("\nAVERAGE USAGE PER REGION:")
print(region_average)


# 5. Sort to find the most at-risk server
sorted_servers = df.sort_values("percent", ascending=False)

print("\nMOST AT-RISK SERVER:")
print(sorted_servers.head(1))


# 6. Classify each server
df["status"] = df["percent"].apply(
    lambda x: "OVER LIMIT" if x >= 95
    else "WARNING" if x >= 90
    else "OK"
)

print("\nSERVER STATUS:")
print(df[["server", "percent", "status"]])


# 7. Create a chart
df["status"].value_counts().plot(kind="bar")

plt.title("Number of Servers Per Status")
plt.xlabel("Server Status")
plt.ylabel("Number of Servers")
plt.tight_layout()
plt.savefig("server_status_chart.png")
plt.close()


# 8. Save OVER LIMIT servers
at_risk = df[df["status"] == "OVER LIMIT"]

at_risk.to_csv("servers_at_risk.csv", index=False)

print("\nOVER LIMIT SERVERS SAVED TO servers_at_risk.csv")



