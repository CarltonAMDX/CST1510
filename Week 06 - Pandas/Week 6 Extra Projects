# WEEK 6 - SURVEY RESULTS REPORT
# AI / DATA SCIENCE

# 1. Load and inspect data
df = pd.read_csv("survey_results.csv")

print("FIRST FIVE RESPONSES")
print(df.head())

print("\nDATA TYPES")
print(df.dtypes)

print("\nTOTAL RESPONSES:", len(df))

# 2. Calculate unanswered percentage
unanswered = df[df["answered"] == 0]

unanswered_percentage = (
    len(unanswered) / len(df)
) * 100

print("\nUNANSWERED RESPONSES:", len(unanswered))
print("PERCENTAGE UNANSWERED:", unanswered_percentage, "%")

# 3. Remove unanswered responses
cleaned = df[df["answered"] == 1].copy()

print("\nCLEANED DATA")
print(cleaned)

# 4. Average score per category
category_average = cleaned.groupby(
    "category"
)["score"].mean()

print("\nAVERAGE SCORE PER CATEGORY")
print(category_average)

# 5. Sort categories
sorted_categories = category_average.sort_values(
    ascending=False
)

print("\nCATEGORIES RANKED")
print(sorted_categories)

print("\nSTRONGEST CATEGORY")
print(sorted_categories.head(1))

# 6. Classify results
cleaned["result"] = cleaned["score"].apply(
    lambda x: "Pass" if x >= 60 else "Fail"
)

print("\nPASS AND FAIL RESULTS")
print(cleaned[["category", "score", "result"]])

# 7. Create chart
cleaned["result"].value_counts().plot(kind="bar")

plt.title("Survey Pass and Fail Results")
plt.xlabel("Result")
plt.ylabel("Number of Responses")
plt.tight_layout()
plt.savefig("survey_results_chart.png")
plt.close()

# 8. Save cleaned data
cleaned.to_csv(
    "survey_results_clean.csv",
    index=False
)

print("\nSaved survey_results_clean.csv")

