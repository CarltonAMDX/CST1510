    guess = input("Enter 1 or 2 (or quit): ").lower()

    if guess == "quit":
        print("Thanks for playing!")
        break

    elif guess == "1":
        if followers1 > followers2:
            print("Correct!")
        else:
            print("Wrong!")

    elif guess == "2":
        if followers2 > followers1:
            print("Correct!")
        else:
            print("Wrong!")

